# Jeenora Server Environment Configuration
# Copy this file to .env and fill in your actual values

PORT=5000
NODE_ENV=development

# MongoDB Database URL
# For local development: mongodb://127.0.0.1:27017/jeenora
# For production: mongodb+srv://username:password@cluster.mongodb.net/database
DB_URL=mongodb://127.0.0.1:27017/jeenora

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:5173

# JWT Secret Key (Use a strong random string)
SECRET=your_jwt_secret_key_here

# Groq AI API Key
GROQ_API_KEY=your_groq_api_key_here

# Admin Credentials (Change these in production!)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# Cloudinary Configuration (for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_email_password

# WhatsApp Configuration
WA_QR_TIMEOUT=120000
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ALLOWED_COUNTRY_CODES=91,93,1,44,86

# Razorpay Configuration (Production/Live Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe Configuration (UAT/Test)
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_API_URL=https://api-preprod.phonepe.com/apis/hermes/pg/v1/pay
PHONEPE_STATUS_URL=https://api-preprod.phonepe.com/apis/hermes/pg/v1/status
PHONEPE_REDIRECT_URL=https://hire.jeenora.com/hire/payments/verify
PHONEPE_CALLBACK_URL=https://api.jeenora.com/api/hire/payment/phonepe-webhook

# Stripe Configuration
STRIPE_KEY=your_stripe_secret_key

# Shiprocket Configuration
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_DEFAULT_PICKUP_PINCODE=624001

# Dashboard URL for Stripe Connect
DASHBOARD_URL=http://localhost:3001